{
  "collection": "products",
  "fields": [
    {
      "id": "sync_product_id",
      "label": "Printful product ID",
      "type": "number",
      "admin_span": 2,
      "readonly": true,
      "description": "The Printful product this was created from. Edit its design, variants and print files in Printful; the sync adds new variants here and takes removed ones off sale. Name, description, prices and photos are yours to edit in Swell."
    },
    {
      "id": "date_synced",
      "label": "Last synced",
      "type": "datetime",
      "admin_span": 2,
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "tabs": [
        {
          "id": "printful",
          "label": "Printful",
          "query": {
            "sync_product_id": {
              "$ne": null
            }
          },
          "fields": [
            {
              "id": "date_synced"
            }
          ]
        }
      ],
      "extra_actions": [
        {
          "id": "sync_now",
          "label": "Sync from Printful",
          "function": "sync-products",
          "hint": "Syncs all your Printful products in the background instead of waiting for the hourly sync.",
          "loading_label": "Starting the Printful sync…"
        }
      ],
      "bulk_actions": [
        {
          "id": "resync_selected",
          "label": "Resync from Printful",
          "function": "product-resync",
          "hint": "Re-reads variants from Printful for the selected products.",
          "loading_label": "Resyncing selected products…",
          "modal": {
            "title": "Resync the selected products?",
            "description": "Products that did not come from Printful are skipped.",
            "submit_label": "Resync",
            "fields": [
              {
                "id": "replace_images",
                "label": "Replace photos with Printful mockups",
                "type": "toggle",
                "default": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "edit",
      "extra_actions": [
        {
          "id": "resync",
          "label": "Resync from Printful",
          "function": "product-resync",
          "hint": "Re-reads this product's variants from Printful.",
          "loading_label": "Resyncing product…",
          "conditions": {
            "$app.printful.sync_product_id": {
              "$ne": null
            }
          }
        }
      ],
      "tabs": [
        {
          "id": "printful",
          "label": "Printful",
          "fields": [
            {
              "type": "field_row",
              "fields": [
                {
                  "id": "sync_product_id"
                },
                {
                  "id": "date_synced"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
