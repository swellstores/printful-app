{
  "collection": "products",
  "fields": [
    {
      "id": "sync_product_id",
      "label": "Printful product ID",
      "type": "number",
      "admin_span": 2,
      "readonly": true,
      "description": "The Printful product this was created from. Edit its design, variants and print files in Printful; the sync adds new variants here and takes removed ones off sale. Name, description, prices and photos are yours to edit in Swell."
    },
    {
      "id": "date_synced",
      "label": "Last synced",
      "type": "datetime",
      "admin_span": 2,
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "tabs": [
        {
          "id": "printful",
          "label": "Printful",
          "query": {
            "sync_product_id": {
              "$ne": null
            }
          },
          "fields": [
            {
              "id": "date_synced"
            }
          ]
        }
      ]
    },
    {
      "id": "edit",
      "tabs": [
        {
          "id": "printful",
          "label": "Printful",
          "fields": [
            {
              "type": "field_row",
              "fields": [
                {
                  "id": "sync_product_id"
                },
                {
                  "id": "date_synced"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
