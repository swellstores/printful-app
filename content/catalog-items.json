{
  "collection": "catalog-items",
  "label": "Printful catalog items",
  "description": "Mapping between Swell product variants and Printful catalog variants, with the base and placement costs the rate and submit paths read.",
  "fields": [
    {
      "id": "catalog_variant_id",
      "label": "Catalog variant ID",
      "type": "integer",
      "readonly": true,
      "admin_span": 2,
      "description": "Printful catalog variant id. Unique across the collection"
    },
    {
      "id": "catalog_product_id",
      "label": "Catalog product ID",
      "type": "integer",
      "readonly": true,
      "admin_span": 2
    },
    {
      "id": "variant",
      "label": "Swell variant",
      "type": "variant_lookup",
      "key": "variant_id",
      "description": "The product variant customers buy. Unset means this catalog variant is synced but not for sale"
    },
    {
      "id": "size",
      "label": "Size",
      "type": "text",
      "readonly": true,
      "admin_span": 2
    },
    {
      "id": "color",
      "label": "Color",
      "type": "text",
      "readonly": true,
      "admin_span": 2
    },
    {
      "id": "currency",
      "label": "Cost currency",
      "type": "text",
      "readonly": true,
      "admin_span": 2
    },
    {
      "id": "stale",
      "label": "Needs resync",
      "type": "toggle",
      "admin_span": 2,
      "description": "Set by Printful price and stock webhooks. The next sync run refetches these rows first"
    },
    {
      "id": "date_synced",
      "label": "Last synced",
      "type": "datetime",
      "readonly": true,
      "admin_span": 2
    },
    {
      "id": "base_cost_by_technique",
      "label": "Base cost by technique",
      "type": "json",
      "readonly": true,
      "description": "Printful base price per technique. Already includes one placement"
    },
    {
      "id": "placement_prices",
      "label": "Placement prices",
      "type": "json",
      "readonly": true,
      "description": "Additional price per placement, beyond the one included in the base cost"
    }
  ],
  "views": [
    {
      "id": "list",
      "nav": {
        "parent": "products",
        "label": "Printful catalog"
      },
      "query": {
        "sort": "date_synced desc"
      },
      "tabs": [
        {
          "id": "stale",
          "label": "Needs resync",
          "query": {
            "stale": true
          }
        },
        {
          "id": "unmapped",
          "label": "Not for sale",
          "query": {
            "variant_id": null
          }
        }
      ],
      "fields": [
        {
          "id": "catalog_variant_id"
        },
        {
          "id": "variant"
        },
        {
          "id": "size"
        },
        {
          "id": "color"
        },
        {
          "id": "currency"
        },
        {
          "id": "stale"
        },
        {
          "id": "date_synced"
        }
      ]
    },
    {
      "id": "edit",
      "title": "Catalog variant {{ catalog_variant_id }}",
      "subtitle": "{{ size }} {{ color }}",
      "fields": [
        {
          "type": "field_row",
          "fields": [
            {
              "id": "catalog_variant_id"
            },
            {
              "id": "catalog_product_id"
            }
          ]
        },
        {
          "id": "variant"
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "size"
            },
            {
              "id": "color"
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "currency"
            },
            {
              "id": "date_synced"
            }
          ]
        },
        {
          "id": "stale"
        },
        {
          "id": "base_cost_by_technique"
        },
        {
          "id": "placement_prices"
        }
      ]
    }
  ]
}
